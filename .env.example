CONF_DIR=.
DATA_DIR=./data
EXPORT_DIR=./export
PALACE_CORES=5

# Volba modelu antény:
# 1 = Původní model se společným T-děličem výkonu a jedním 50 Ohm portem
# 2 = Dvouportový model se dvěma nezávislými 100 Ohm mikropásky a LHCP fázováním
# 3 = Model 3 (Cesta B): Hybridní dvoustupňové přizpůsobení (mělký zářez + transformátor + 100 Ohm napaječ)
ANTENNA_MODEL=1

# Frekvenční rozsah a krok sweepu (GHz)
FREQ_MIN=2.320
FREQ_MAX=2.345
FREQ_STEP=0.005

# Nastavení sítě (mm) a adaptivního zjemnění (AMR)
MESH_SIZE_MAX=8.0
MESH_SIZE_MIN=0.5
MESH_DIST_MIN=0.5
MESH_DIST_MAX=6.0
AMR_MAX_ITS=2
AMR_THRESHOLD=0.2

# Nastavení lineárního řešiče FGMRES
LINEAR_TOL=1e-6
LINEAR_MAX_ITS=100

# Vzorkování dálkového pole (počet bodů na kouli, např. 16200 = krok 2°)
FARFIELD_NSAMPLE=16200

# Ukládání 3D polí pro ParaView a fázové animace (1 = každý frekvenční krok, 0 = pouze S-parametry)
SAVE_STEP=1

# Geometrie vyzařujícího flíčku (mm)
PATCH_L=30.3
PATCH_W=30.3

# Zanoření napaječe (inset feed) pro Model 1 v mm (0.0 = napájení na hraně)
FEED_INSET=0.0
FEED_INSET_GAP=0.5

# Zanoření napaječů pro Model 2 (nezávislé zanoření spodního Ey a levého Ex napaječe)
FEED_INSET_B=0.0
FEED_INSET_L=0.0
FEED_INSET_GAP_B=0.5
FEED_INSET_GAP_L=0.5

# Explicitní délky napaječů pro Model 2 v mm (volitelné; výchozí: feed_len_l = L_ref, feed_delta_l = lambda_g/4)
# FEED_LEN_B=43.51
# FEED_LEN_L=24.85
# FEED_DELTA_L=18.66

# Parametry pro Model 3 (Hybridní dvoustupňové přizpůsobení, Cesta B):
# Šířka vnitřního transformátoru w_T v mm (výchozí: 0.42 mm -> Z_T ≈ 118.7 Ohm)
TRANS_W=0.42
# Délka transformátoru l_T v mm (volitelné; výchozí: auto lambda_g/4 ≈ 18.88 mm)
# TRANS_L=18.88

# Režim buzení portů pro Model 2 a Model 3:
# 'all' = současné buzení obou portů (LHCP vyzařování, aktivní interference)
# '1'   = buzení pouze spodního portu 1 (Ey), port 2 ukončen 100 Ohm zátěží (izolovaná S-matice S11, S21 v port-S.csv)
# '2'   = buzení pouze levého portu 2 (Ex), port 1 ukončen 100 Ohm zátěží (izolovaná S-matice S22, S12 v port-S.csv)
DRIVEN_PORT=all

# Substrát a dielektrikum (volitelné)
# SUB_H=1.52
# EPS_R=4.3
# TAN_DELTA=0.02

# =====================================================================
# PROFIL PRO SWEEPOVÁNÍ MODELU 2
# Tyto hodnoty automaticky přebíjí výchozí parametry při spuštění sweep.py
# =====================================================================
# Cíl sweepování pro Model 2: 'inset' (výchozí), 'patch_l', 'delta_l', 'feed_len_b', 'feed_len_l', 'feed_lens'
SWEEP_TARGET=inset

# A. Nastavení pro sweep zanoření (SWEEP_TARGET=inset):
# Režim sweepování: 'symmetric', 'single_fixed', 'grid', 'manual'
SWEEP_MODE=symmetric
SWEEP_INSETS=0.0, 3.0, 4.5, 4.8, 5.0, 5.2

# Nastavení pro režim 'single_fixed' u Modelu 2:
SWEEP_FIXED_INSET_NAME=inset_l
SWEEP_FIXED_INSET_VAL=2.5

# Nastavení pro režim 'grid' u Modelu 2:
SWEEP_INSETS_B=2.0, 3.0, 4.0
SWEEP_INSETS_L=1.0, 2.0, 3.0, 4.0

# Nastavení pro režim 'manual' u Modelu 2:
# Možnost A: Explicitní dvojice zanoření (spodní:levý)
SWEEP_MANUAL_PAIRS=4.8:5.2, 5.0:5.2, 5.2:5.4
# Možnost B: Paralelní seznamy zanoření pro 1:1 spárování (musí mít stejnou délku)
# SWEEP_INSETS_B=4.8, 5.0, 5.2
# SWEEP_INSETS_L=5.2, 5.2, 5.4

# B. Nastavení pro sweep délek napaječů a fázovacího úseku Delta L:
# Sweepování fázovacího úseku Delta L (SWEEP_TARGET=delta_l):
# SWEEP_DELTA_L=16.0, 17.0, 18.0, 18.66, 19.0, 20.0
# Fixní délka levého napaječe při sweepu Delta L:
# SWEEP_FEED_LEN_L=24.85

# Sweepování jednotlivých délek napaječů (SWEEP_TARGET=feed_len_b / feed_len_l / feed_lens):
# SWEEP_FEED_LENS_B=35.0, 40.0, 43.51, 45.0, 50.0
# SWEEP_FEED_LENS_L=20.0, 22.0, 24.85, 26.0, 28.0

# C. Nastavení pro sweep délky flíčku (SWEEP_TARGET=patch_l):
# SWEEP_TARGET=patch_l
# SWEEP_PATCH_LENGTHS=28.4, 28.6, 28.8, 29.0, 29.2

# Buzení pro sweep Modelu 2 ('all', '1', '2')
SWEEP_DRIVEN_PORT=all

SWEEP_FREQ_MIN=2.280
SWEEP_FREQ_MAX=2.380
SWEEP_FREQ_STEP=0.005
SWEEP_AMR_MAX_ITS=1
SWEEP_AMR_THRESHOLD=0.3
SWEEP_FARFIELD_NSAMPLE=16200
SWEEP_LINEAR_TOL=1e-5
SWEEP_LINEAR_MAX_ITS=100
SWEEP_SAVE_STEP=1
SWEEP_EXPORT_EACH=true
SWEEP_PATCH_L=30.3
SWEEP_PATCH_W=30.3
