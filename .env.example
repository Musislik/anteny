# ==============================================================================
# KONFIGURAČNÍ SOUBOR PRO SIMULACE A SWEEPY MIKROPÁSKOVÉ ANTÉNY (SDARS 2.332 GHz)
# ==============================================================================
# Tento vzorový soubor slouží jako šablona pro soubor '.env'.
# Zkopírujte jej: 'copy .env.example .env' a upravte podle potřeby.

# ==============================================================================
# 1. SPOLEČNÉ PARAMETRY (PRO MAIN I SWEEP)
# ==============================================================================
# Tyto parametry definují systémové cesty, hardwarové prostředky, volbu modelu
# a základní materiálové vlastnosti společné pro jednorázový běh i parametrický sweep.

# --- 1.1 Systémové cesty a výpočetní prostředky ---
# Při spuštění celého pipeline v kontejneru (`docker compose run --rm pipeline`,
# Docker-out-of-Docker přes `/var/run/docker.sock`) musí `CONF_DIR` a `DATA_DIR`
# obsahovat absolutní cesty na hostiteli, aby kontejner `palace` připojil správné
# hostitelské složky. Při lokálním spuštění Pythonu (`python src/main.py` nebo
# `python src/sweep.py`) se solverem `palace` v Dockeru fungují relativní cesty `.` a `./data`.
CONF_DIR=.
DATA_DIR=./data
EXPORT_DIR=./export
# Počet CPU jader přidělených řešiči Palace v Dockeru (MPI paralelismus)
PALACE_CORES=5

# --- 1.2 Volba modelu antény ---
# ANTENNA_MODEL určuje topologii antény a generátor geometrie:
#   1 = Model 1 (geometry_v1.py): Původní model s jedním 50 Ohm portem a integrovaným
#       T-děličem výkonu a fázovacím vedením na jedné desce.
#   2 = Model 2 (geometry_v2.py): Dvouportový model se dvěma 100 Ohm napaječi, přímým
#       zanořením do flíčku a integrovaným fázovačem Delta L na Portu 1.
#   3 = Model 3 (geometry_v3.py): Hybridní dvoustupňové přizpůsobení (Cesta B) –
#       mělký zářez y0 (cca 2.5 mm) + čtvrtvlnný transformátor w_T (cca 0.42 mm)
#       transformující flíček na 100 Ohm + přizpůsobené 100 Ohm vedení s fázovačem Delta L.
#   4 = Model 4 (geometry_v4.py): Finální model dokončující Model 3 – spojení obou
#       100 Ohm napájecích větví plynulými oblouky do T-článku na jediný 50 Ohm port.
ANTENNA_MODEL=4

# --- 1.3 Parametry dielektrického substrátu ---
# Výška dielektrika v mm (výchozí: 1.52 mm pro standardní VF laminát / FR-4)
SUB_H=1.52
# Relativní permitivita substrátu epsilon_r (výchozí: 4.3 pro FR-4)
EPS_R=4.3
# Ztrátový činitel dielektrika tan(delta) (výchozí: 0.02 pro FR-4)
TAN_DELTA=0.02
# Návrhová střední frekvence pro syntézu lambda_g/4 úseků v GHz (výchozí: 2.3325)
DESIGN_FREQ_GHZ=2.3325

# --- 1.4 Základní geometrie vyzařujícího flíčku ---
# Rozměry čtvercového rezonátoru v mm (pro SDARS 2.3325 GHz):
#   - Pro Model 1: výchozí 30.30 mm
#   - Pro Model 2, 3 a 4: výchozí 28.80 mm (odladěné hodnoty v Modelu 3 např. 29.81 mm)
PATCH_L=28.8
PATCH_W=28.8


# ==============================================================================
# 2. PARAMETRY PRO JEDNORÁZOVOU SIMULACI (MAIN - python src/main.py)
# ==============================================================================
# Tyto parametry řídí přímé spuštění simulátoru přes 'main.py' (nebo 'docker compose run').

# --- 2.1 Frekvenční rozsah simulace ---
# Frekvence v GHz dle zadání SDARS (pracovní pásmo 2.320 až 2.345 GHz):
FREQ_MIN=2.320
FREQ_MAX=2.345
# Krok frekvence v GHz (např. 0.001 = krok 1 MHz pro detailní křivku, 0.005 = 5 MHz pro rychlý test)
FREQ_STEP=0.001

# --- 2.2 Výpočetní síť (Gmsh) a adaptivní zjemnění (AMR) ---
# Maximální velikost elementu sítě v objemu vzduchu v mm
MESH_SIZE_MAX=8.0
# Minimální velikost elementu na hranách vodičů a štěrbin v mm
MESH_SIZE_MIN=0.5
# Vzdálenost od vodičů s nejjemnější sítí v mm
MESH_DIST_MIN=0.5
# Vzdálenost, od níž přechází síť na maximální velikost MESH_SIZE_MAX v mm
MESH_DIST_MAX=6.0
# Počet adaptivních zjemnění sítě řešičem Palace (AMR):
#   0 = vypnuto (rychlý výpočet na výchozí síti)
#   1 až 3 = počet adaptivních kroků zjemnění podle chyby pole
AMR_MAX_ITS=2
# Relativní tolerance chyby pole pro ukončení AMR zjemnění (výchozí: 0.2 = 20 %)
AMR_THRESHOLD=0.2

# --- 2.3 Numerický lineární řešič (Palace - FGMRES / SuperLU) ---
# Relativní tolerance konvergence lineárního řešiče FGMRES
LINEAR_TOL=1e-6
# Maximální počet iterací lineárního řešiče
LINEAR_MAX_ITS=100
# Řád bázových funkcí FEM řešiče Palace (výchozí: 2)
# SOLVER_ORDER=2

# --- 2.4 Dálkové pole (Far-Field) a ukládání 3D polí ---
# Počet vzorkovacích bodů na kouli dálkového pole (např. 16200 = krok 2° v theta i phi, 4050 = krok 4°)
FARFIELD_NSAMPLE=16200
# Krok ukládání 3D polí do postpro složky pro ParaView:
#   1 = ukládat pole v každém frekvenčním kroku (umožňuje fázové animace a 3D zobrazení)
#   0 = neukládat 3D pole, počítat pouze S-parametry a dálkové pole (rychlé, šetří disk)
SAVE_STEP=1

# --- 2.5 Impedance portů a režim buzení ---
# Jmenovitá impedance lumped portu v Ohmech: pokud je zakomentována, `main.py`
# automaticky zvolí 50.0 pro ANTENNA_MODEL=1/4 a 100.0 pro ANTENNA_MODEL=2/3,
# není-li explicitně přepsána v `.env` nebo přepínačem `--port-impedance`.
# PORT_IMPEDANCE=50.0
# Režim buzení portů pro 2-portové modely (Model 2 a Model 3):
#   'all' (nebo 'matrix', 'both') = Dvoukrokový výpočet pro kompletní 2-portovou matici S11, S21, S12, S22
#                                   a vyzařování LHCP/RHCP včetně osového poměru AR.
#   '1'   (nebo 'bottom', 'ey')   = Buzení pouze spodního Portu 1 (Ey), Port 2 ukončen 100 Ohm zátěží.
#   '2'   (nebo 'left', 'ex')     = Buzení pouze levého Portu 2 (Ex), Port 1 ukončen 100 Ohm zátěží.
#   'simultaneous'                = Buzení obou portů v jediném simulačním kroku současně.
DRIVEN_PORT=all

# --- 2.6 Geometrické parametry specifické pro MODEL 1 ---
# Zanoření napaječe do flíčku v mm (0.0 = napájení přímo na vnější hraně flíčku)
FEED_INSET=0.0
# Šířka mezery zářezu v mm
FEED_INSET_GAP=0.5

# --- 2.7 Geometrické parametry specifické pro MODEL 2 ---
# Zanoření spodního (Ey) a levého (Ex) napaječe v mm (pro hluboké zářezy typicky 4.8 až 5.4 mm;
# vzor pro ANTENNA_MODEL=2 – odkomentujte při použití Modelu 2, výchozí hodnoty níže platí pro Model 3)
# FEED_INSET_B=5.2
# FEED_INSET_L=5.2
# FEED_INSET_GAP_B=0.5
# FEED_INSET_GAP_L=0.5
# Explicitní délky napaječů pro Model 2 v mm (volitelné; výchozí: auto dle lambda_g/4)
# FEED_LEN_B=43.51
# FEED_LEN_L=24.85
# FEED_DELTA_L=18.66

# --- 2.8 Geometrické parametry specifické pro MODEL 3 a MODEL 4 (Hybridní přizpůsobení) ---
# Mělký zářez na spodním a levém rameni v mm (výchozí: 2.50 mm pro snížení impedance hrany na ~140 Ohm)
FEED_INSET_B=2.5
FEED_INSET_L=2.5
FEED_INSET_GAP_B=0.5
FEED_INSET_GAP_L=0.5
# Šířka vnitřního čtvrtvlnného transformátoru w_T v mm (výchozí: 0.42 mm -> impedance Z_T ≈ 118.7 Ohm)
TRANS_W=0.42
# Fyzická délka transformátoru l_T v mm (volitelné; výchozí: auto lambda_g/4 ≈ 18.88 mm)
# TRANS_L=18.88
# Fázovací úsek Delta L v přizpůsobeném 100 Ohm vedení v mm (výchozí: auto lambda_g/4 ≈ 18.66 mm)
# FEED_DELTA_L=18.66

# --- 2.9 Geometrické parametry specifické pro MODEL 4 (Finální model: otočený levý 50 Ohm T-článek bez meandru) ---
# Poloměr střednice kruhových oblouků všech 90° ohybů v mm (výchozí: 3.0 mm >= 3*w_100)
FEED_BEND_RADIUS=3.0
# Poloměr zaoblení vnitřních rohů T-článku v mm (0.0 = ostrý T-uzel, výchozí: 0.8 mm)
FEED_T_FILLET_R=0.8
# Délka hlavního 50 Ohm přívodu od levého okraje substrátu k levé hraně svislé příčky T-článku v mm (výchozí: 9.0 mm)
FEED_50_LEN=9.0
# Volitelné přepisy šířek vedení v mm (výchozí: auto syntéza z PORT_IMPEDANCE a 2*PORT_IMPEDANCE)
# FEED_50_W=2.98
# FEED_100_W=0.694
# Minimální rovný vstupní úsek před transformátory (Případ 2: >= 3*h, výchozí: 4.6 mm)
FEED_END_STRAIGHT=4.6
# Boční odstup svislé 100 Ohm osy od vstupu levého transformátoru x_junc_l v mm (výchozí: auto = FEED_END_STRAIGHT + FEED_BEND_RADIUS = 7.6 mm)
# FEED_ARM_OFFSET=7.6
# Minimální okraj dielektrika substrátu vně vodičů v mm (výchozí: 8.0 mm >= 5*h)
SUB_MARGIN=8.0
# Volitelné explicitní zafixování souřadnic T-článku a minimálních rozměrů substrátu v mm:
# FEED_T_X=-38.88
# FEED_T_Y=-28.91
# SUB_W=96.46
# SUB_L=94.46


# ==============================================================================
# 3. PARAMETRY PRO PARAMETRICKÝ SWEEP (SWEEP - python src/sweep.py)
# ==============================================================================
# Zde si volíte jeden ze dvou profilů sweepu nastavením proměnné SWEEP_PROFILE:
#   SWEEP_PROFILE=precise  -> 3.1 PŘESNÝ KONVERGOVANÝ SWEEP (garantovaná přesnost, frekvence neuskočí)
#   SWEEP_PROFILE=fast     -> 3.2 RYCHLÝ PRŮZKUMNÝ SWEEP (bleskový orientační běh)
SWEEP_PROFILE=precise

# --- Společná nastavení pro sweepování (platná pro oba profily) ---
# Cíl sweepování SWEEP_TARGET určuje, jaký fyzikální parametr se v řadě mění:
#   'patch_l'     = Sweepování rezonanční délky flíčku L pro vycentrování frekvence (M1..M4)
#   'trans_w'     = Sweepování šířky čtvrtvlnného transformátoru w_T (M3, M4)
#   'trans_l'     = Sweepování délky transformátoru l_T (M3, M4)
#   'delta_l'     = Sweepování fázovacího úseku Delta L v 100 Ohm vedení pro kruhovou polarizaci / AR (M2..M4)
#   'inset'       = Sweepování zanoření napaječe (M1..M4)
#   'bend_radius' = Sweepování poloměru oblouků ohybů (pouze Model 4)
#   'feed_50_len' = Sweepování délky 50 Ohm přívodu k T-článku (pouze Model 4)
#   'feed_lens'   = Sweepování délek napájecích mikropásků (Model 2)
SWEEP_TARGET=patch_l

# Buzení během sweepu:
#   '2'   = buzení pouze Portu 2 (rychlé ladění levého ramene Ex bez fázovače)
#   '1'   = buzení pouze Portu 1 (rychlé ladění spodního ramene Ey)
#   'all' = kompletní 2-kroková simulace obou portů (matice, LHCP vyzařování a AR)
SWEEP_DRIVEN_PORT=2

# Seznam sweepovaných rozměrů flíčku L = W v mm:
SWEEP_PATCH_LENGTHS=29.6, 29.7, 29.8, 29.81, 29.9, 30.0

# Volitelné seznamy pro jiné cíle sweepování:
# SWEEP_TRANS_W=0.35, 0.38, 0.40, 0.42, 0.45, 0.50
# SWEEP_TRANS_L=17.5, 18.0, 18.5, 18.88, 19.5, 20.0
# SWEEP_DELTA_L=17.0, 17.5, 18.0, 18.66, 19.0, 19.5
# SWEEP_INSETS=1.5, 2.0, 2.5, 3.0, 3.5
# SWEEP_BEND_RADII=2.0, 2.5, 3.0, 3.5, 4.0
# SWEEP_FEED_50_LEN=6.0, 8.0, 9.0, 10.0, 12.0

# Export balíčků po každém kroku sweepu (ZIP s daty a grafy):
SWEEP_EXPORT_EACH=true

# Fixní rozměry flíčku během sweepování jiných cílů:
SWEEP_PATCH_L=29.81
SWEEP_PATCH_W=29.81


# ------------------------------------------------------------------------------
# 3.1 SEKCE PRO PŘESNÝ SWEEP (SWEEP_PROFILE=precise)
#     Garantovaná vysoká přesnost (AMR adaptivní zjemnění na chybu pole < 6 %,
#     stabilita rezonanční frekvence < 0.2 MHz bez diskretizačních skoků).
# ------------------------------------------------------------------------------
SWEEP_PRECISE_FREQ_MIN=2.320
SWEEP_PRECISE_FREQ_MAX=2.345
SWEEP_PRECISE_FREQ_STEP=0.001

# Deterministická počáteční síť Gmsh (rozlišuje štěrbinu 0.5 mm na 2-3 elementy)
SWEEP_PRECISE_MESH_SIZE_MAX=6.0
SWEEP_PRECISE_MESH_SIZE_MIN=0.28
SWEEP_PRECISE_MESH_DIST_MIN=0.4
SWEEP_PRECISE_MESH_DIST_MAX=4.5

# Adaptivní zjemnění AMR: až 3 iterace pro zaručené sražení chyby pole pod 6 %
SWEEP_PRECISE_AMR_MAX_ITS=3
SWEEP_PRECISE_AMR_THRESHOLD=0.06

# Lineární řešič FGMRES pro přesný sweep
SWEEP_PRECISE_LINEAR_TOL=1e-6
SWEEP_PRECISE_LINEAR_MAX_ITS=200

# Vzorkování dálkového pole (4050 bodů = krok 4° pro optimální rychlost)
SWEEP_PRECISE_FARFIELD_NSAMPLE=4050
# Ukládání 3D polí (0 = pouze numerické výsledky, šetří místo na disku)
SWEEP_PRECISE_SAVE_STEP=0


# ------------------------------------------------------------------------------
# 3.2 SEKCE PRO RYCHLÝ SWEEP (SWEEP_PROFILE=fast)
#     Bleskový orientační sweep pro hrubé hledání a zmapování parametrů.
#     AMR je vypnuto (0 iterací), řidší síť, větší krok frekvence 2 MHz.
# ------------------------------------------------------------------------------
SWEEP_FAST_FREQ_MIN=2.320
SWEEP_FAST_FREQ_MAX=2.345
SWEEP_FAST_FREQ_STEP=0.002

# Řidší počáteční síť Gmsh
SWEEP_FAST_MESH_SIZE_MAX=8.0
SWEEP_FAST_MESH_SIZE_MIN=0.35
SWEEP_FAST_MESH_DIST_MIN=0.5
SWEEP_FAST_MESH_DIST_MAX=5.0

# Adaptivní zjemnění AMR vypnuto pro maximální rychlost
SWEEP_FAST_AMR_MAX_ITS=0
SWEEP_FAST_AMR_THRESHOLD=0.15

# Lineární řešič s mírnější tolerancí
SWEEP_FAST_LINEAR_TOL=1e-5
SWEEP_FAST_LINEAR_MAX_ITS=100

# Redukované vzorkování dálkového pole
SWEEP_FAST_FARFIELD_NSAMPLE=2025
SWEEP_FAST_SAVE_STEP=0
