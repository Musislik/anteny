# ==============================================================================
# KONFIGURAČNÍ SOUBOR PRO SIMULACE A SWEEPY MIKROPÁSKOVÉ ANTÉNY (SDARS 2.332 GHz)
# ==============================================================================
# Tento vzorový soubor slouží jako šablona pro soubor '.env'.
# Zkopírujte jej: 'copy .env.example .env' a upravte podle potřeby.

# ==============================================================================
# 1. SPOLEČNÉ PARAMETRY (PRO MAIN I SWEEP)
# ==============================================================================
# Tyto parametry definují systémové cesty, hardwarové prostředky, volbu modelu
# a základní materiálové vlastnosti společné pro jednorázový běh i parametrický sweep.

# --- 1.1 Systémové cesty a výpočetní prostředky ---
CONF_DIR=.
DATA_DIR=./data
EXPORT_DIR=./export
# Počet CPU jader přidělených řešiči Palace v Dockeru (MPI paralelismus)
PALACE_CORES=5

# --- 1.2 Volba modelu antény ---
# ANTENNA_MODEL určuje topologii antény a generátor geometrie:
#   1 = Model 1 (geometry_v1.py): Původní model s jedním 50 Ohm portem a integrovaným
#       T-děličem výkonu a fázovacím vedením na jedné desce.
#   2 = Model 2 (geometry_v2.py): Dvouportový model se dvěma 100 Ohm napaječi, přímým
#       zanořením do flíčku a integrovaným fázovačem Delta L na Portu 1.
#   3 = Model 3 (geometry_v3.py): Hybridní dvoustupňové přizpůsobení (Cesta B) –
#       mělký zářez y0 (cca 2.5 mm) + čtvrtvlnný transformátor w_T (cca 0.42 mm)
#       transformující flíček na 100 Ohm + přizpůsobené 100 Ohm vedení s fázovačem Delta L.
ANTENNA_MODEL=3

# --- 1.3 Parametry dielektrického substrátu ---
# Výška dielektrika v mm (výchozí: 1.52 mm pro standardní VF laminát / FR-4)
SUB_H=1.52
# Relativní permitivita substrátu epsilon_r (výchozí: 4.3 pro FR-4)
EPS_R=4.3
# Ztrátový činitel dielektrika tan(delta) (výchozí: 0.02 pro FR-4)
TAN_DELTA=0.02

# --- 1.4 Základní geometrie vyzařujícího flíčku ---
# Rozměry čtvercového rezonátoru v mm (pro SDARS 2.3325 GHz):
#   - Pro Model 1: výchozí 30.30 mm
#   - Pro Model 2 a 3: výchozí 28.80 mm
PATCH_L=28.8
PATCH_W=28.8


# ==============================================================================
# 2. PARAMETRY PRO JEDNORÁZOVOU SIMULACI (MAIN - python src/main.py)
# ==============================================================================
# Tyto parametry řídí přímé spuštění simulátoru přes 'main.py' (nebo 'docker compose run').

# --- 2.1 Frekvenční rozsah simulace ---
# Frekvence v GHz dle zadání SDARS (pracovní pásmo 2.320 až 2.345 GHz):
FREQ_MIN=2.320
FREQ_MAX=2.345
# Krok frekvence v GHz (např. 0.001 = krok 1 MHz pro detailní křivku, 0.005 = 5 MHz pro rychlý test)
FREQ_STEP=0.001

# --- 2.2 Výpočetní síť (Gmsh) a adaptivní zjemnění (AMR) ---
# Maximální velikost elementu sítě v objemu vzduchu v mm
MESH_SIZE_MAX=8.0
# Minimální velikost elementu na hranách vodičů a štěrbin v mm
MESH_SIZE_MIN=0.5
# Vzdálenost od vodičů s nejjemnější sítí v mm
MESH_DIST_MIN=0.5
# Vzdálenost, od níž přechází síť na maximální velikost MESH_SIZE_MAX v mm
MESH_DIST_MAX=6.0
# Počet adaptivních zjemnění sítě řešičem Palace (AMR):
#   0 = vypnuto (rychlý výpočet na výchozí síti)
#   1 až 3 = počet adaptivních kroků zjemnění podle chyby pole
AMR_MAX_ITS=2
# Relativní tolerance chyby pole pro ukončení AMR zjemnění (výchozí: 0.2 = 20 %)
AMR_THRESHOLD=0.2

# --- 2.3 Numerický lineární řešič (Palace - FGMRES / SuperLU) ---
# Relativní tolerance konvergence lineárního řešiče FGMRES
LINEAR_TOL=1e-6
# Maximální počet iterací lineárního řešiče
LINEAR_MAX_ITS=100

# --- 2.4 Dálkové pole (Far-Field) a ukládání 3D polí ---
# Počet vzorkovacích bodů na kouli dálkového pole (např. 16200 = krok 2° v theta i phi, 4050 = krok 4°)
FARFIELD_NSAMPLE=16200
# Krok ukládání 3D polí do postpro složky pro ParaView:
#   1 = ukládat pole v každém frekvenčním kroku (umožňuje fázové animace a 3D zobrazení)
#   0 = neukládat 3D pole, počítat pouze S-parametry a dálkové pole (rychlé, šetří disk)
SAVE_STEP=1

# --- 2.5 Impedance portů a režim buzení ---
# Jmenovitá impedance lumped portu v Ohmech (50.0 pro Model 1, 100.0 pro Model 2 a 3)
PORT_IMPEDANCE=100.0
# Režim buzení portů pro 2-portové modely (Model 2 a Model 3):
#   'all' (nebo 'matrix', 'both') = Dvoukrokový výpočet pro kompletní 2-portovou matici S11, S21, S12, S22
#                                   a vyzařování LHCP/RHCP včetně osového poměru AR.
#   '1'   (nebo 'bottom', 'ey')   = Buzení pouze spodního Portu 1 (Ey), Port 2 ukončen 100 Ohm zátěží.
#   '2'   (nebo 'left', 'ex')     = Buzení pouze levého Portu 2 (Ex), Port 1 ukončen 100 Ohm zátěží.
#   'simultaneous'                = Buzení obou portů v jediném simulačním kroku současně.
DRIVEN_PORT=all

# --- 2.6 Geometrické parametry specifické pro MODEL 1 ---
# Zanoření napaječe do flíčku v mm (0.0 = napájení přímo na vnější hraně flíčku)
FEED_INSET=0.0
# Šířka mezery zářezu v mm
FEED_INSET_GAP=0.5

# --- 2.7 Geometrické parametry specifické pro MODEL 2 ---
# Zanoření spodního (Ey) a levého (Ex) napaječe v mm (pro hluboké zářezy typicky 4.8 až 5.4 mm)
FEED_INSET_B=5.2
FEED_INSET_L=5.2
FEED_INSET_GAP_B=0.5
FEED_INSET_GAP_L=0.5
# Explicitní délky napaječů pro Model 2 v mm (volitelné; výchozí: auto dle lambda_g/4)
# FEED_LEN_B=43.51
# FEED_LEN_L=24.85
# FEED_DELTA_L=18.66

# --- 2.8 Geometrické parametry specifické pro MODEL 3 (Hybridní přizpůsobení, Cesta B) ---
# Mělký zářez na spodním a levém rameni v mm (výchozí: 2.50 mm pro snížení impedance hrany na ~140 Ohm)
FEED_INSET_B=2.5
FEED_INSET_L=2.5
FEED_INSET_GAP_B=0.5
FEED_INSET_GAP_L=0.5
# Šířka vnitřního čtvrtvlnného transformátoru w_T v mm (výchozí: 0.42 mm -> impedance Z_T ≈ 118.7 Ohm)
TRANS_W=0.42
# Fyzická délka transformátoru l_T v mm (volitelné; výchozí: auto lambda_g/4 ≈ 18.88 mm)
# TRANS_L=18.88
# Fázovací úsek Delta L v přizpůsobeném 100 Ohm vedení Portu 1 v mm (výchozí: auto lambda_g/4 ≈ 18.66 mm)
# FEED_DELTA_L=18.66


# ==============================================================================
# 3. PARAMETRY PRO PARAMETRICKÝ SWEEP (SWEEP - python src/sweep.py)
# ==============================================================================
# Tyto proměnné s předponou SWEEP_ automaticky přebíjejí výchozí parametry při spuštění sweepu.

# --- 3.1 Cíl a režim sweepování ---
# Cíl sweepování SWEEP_TARGET určuje, jaký fyzikální parametr se v řadě mění:
#   'inset'    = Sweepování zanoření napaječe (pro M1, M2 i M3)
#   'trans_w'  = Sweepování šířky čtvrtvlnného transformátoru w_T (pouze Model 3)
#   'trans_l'  = Sweepování délky transformátoru l_T (pouze Model 3)
#   'delta_l'  = Sweepování fázovacího úseku Delta L v 100 Ohm vedení pro kruhovou polarizaci / AR (M2, M3)
#   'patch_l'  = Sweepování rezonanční délky flíčku L pro vycentrování frekvence (M1, M2, M3)
#   'feed_lens'= Sweepování délek napájecích mikropásků (Model 2)
SWEEP_TARGET=inset

# Režim párování SWEEP_MODE (používá se při SWEEP_TARGET=inset nebo feed_lens):
#   'symmetric'    = Symetrický sweep: obě ramena mají shodnou hodnotu (y0b = y0l = SWEEP_INSETS)
#   'single_fixed' = Fixní hodnota jednoho portu, sweepování druhého portu
#   'grid'         = 2D kartézská mřížka všech kombinací SWEEP_INSETS_B x SWEEP_INSETS_L
#   'manual'       = Explicitně definované dvojice v SWEEP_MANUAL_PAIRS
SWEEP_MODE=symmetric

# --- 3.2 Nastavení pro sweep zanoření (SWEEP_TARGET=inset) ---
# A. Hodnoty pro symetrický sweep (SWEEP_MODE=symmetric) nebo sweepované rameno v single_fixed:
#    - Pro Model 3 (mělký zářez): doporučeno 1.5, 2.0, 2.5, 3.0, 3.5 mm
#    - Pro Model 2 (hluboký zářez): doporučeno 4.8, 5.0, 5.2, 5.4, 5.6 mm
SWEEP_INSETS=1.5, 2.0, 2.5, 3.0, 3.5

# B. Nastavení pro režim 'single_fixed':
# Který port zůstává fixní:
#   'inset_l' = fixní je levý port Ex, sweepuje se spodní port Ey
#   'inset_b' = fixní je spodní port Ey, sweepuje se levý port Ex
SWEEP_FIXED_INSET_NAME=inset_l
SWEEP_FIXED_INSET_VAL=2.5

# C. Nastavení pro 2D mřížku (SWEEP_MODE=grid):
SWEEP_INSETS_B=2.0, 2.5, 3.0
SWEEP_INSETS_L=2.0, 2.5, 3.0

# D. Nastavení pro manuální dvojice (SWEEP_MODE=manual):
# Formát: spodní:levý, např. '2.0:2.5, 2.5:2.5, 3.0:2.5'
SWEEP_MANUAL_PAIRS=2.0:2.5, 2.5:2.5, 3.0:2.5

# --- 3.3 Nastavení pro sweep transformátoru Modelu 3 (SWEEP_TARGET=trans_w / trans_l) ---
# Seznam sweepovaných šířek transformátoru w_T v mm (pro doladění impedance na 100 Ohm):
SWEEP_TRANS_W=0.35, 0.38, 0.40, 0.42, 0.45, 0.50
# Seznam sweepovaných délek transformátoru l_T v mm:
SWEEP_TRANS_L=17.5, 18.0, 18.5, 18.88, 19.5, 20.0

# --- 3.4 Nastavení pro sweep fázování Delta L a délek napaječů ---
# Seznam sweepovaných hodnot fázovacího úseku Delta L v mm (SWEEP_TARGET=delta_l):
# (Kolem teoretické hodnoty lambda_g/4 = 18.66 mm pro minimalizaci osového poměru AR < 1.5 dB)
SWEEP_DELTA_L=17.0, 17.5, 18.0, 18.66, 19.0, 19.5

# Sweepování jednotlivých délek napaječů pro Model 2 (SWEEP_TARGET=feed_len_b / feed_len_l / feed_lens):
# SWEEP_FEED_LENS_B=35.0, 40.0, 43.51, 45.0, 50.0
# SWEEP_FEED_LENS_L=20.0, 22.0, 24.85, 26.0, 28.0
# Fixní délka levého napaječe při sweepu Delta L:
# SWEEP_FEED_LEN_L=24.85

# --- 3.5 Nastavení pro sweep délky flíčku (SWEEP_TARGET=patch_l) ---
# Seznam sweepovaných rozměrů flíčku L = W v mm (pro vycentrování rezonance f0 na 2.3325 GHz):
SWEEP_PATCH_LENGTHS=28.4, 28.6, 28.8, 29.0, 29.2

# --- 3.6 Nastavení řešiče, sítě a exportu během sweepu ---
# Buzení během sweepu:
#   'all' = kompletní 2-kroková simulace obou portů (výpočet kompletní matice i LHCP vyzařování a AR)
#   '1'   = buzení pouze Portu 1 (rychlé ladění odrazu S11 a rezonance spodního ramene)
#   '2'   = buzení pouze Portu 2 (rychlé ladění odrazu S22 a rezonance levého ramene)
SWEEP_DRIVEN_PORT=all

# Frekvenční rozsah během sweepu (GHz):
SWEEP_FREQ_MIN=2.320
SWEEP_FREQ_MAX=2.345
SWEEP_FREQ_STEP=0.001

# Rychlost sítě během sweepu:
#   0 = bez adaptivního zjemnění AMR (rychlé sweepování parametrů)
#   1 až 2 = AMR zjemnění pro finální vysokou přesnost
SWEEP_AMR_MAX_ITS=0
SWEEP_AMR_THRESHOLD=0.3

# Vzorkování dálkového pole během sweepu (4050 bodů = krok 4° pro vyšší rychlost sweepu, 16200 = krok 2°)
SWEEP_FARFIELD_NSAMPLE=4050

# Nastavení lineárního řešiče FGMRES během sweepu
SWEEP_LINEAR_TOL=1e-5
SWEEP_LINEAR_MAX_ITS=100

# Ukládání 3D polí během sweepu:
#   0 = pouze numerické výsledky (rychlé, minimální nároky na disk)
#   1 = ukládat kompletní 3D pole pro ParaView pro každý krok sweepu
SWEEP_SAVE_STEP=0

# Export balíčků po každém kroku sweepu:
#   true  = automaticky vytvořit ZIP balíček v export/ s daty a skripty pro každý krok
#   false = neexportovat ZIP balíčky, pouze zapsat data do CSV a Markdown tabulky
SWEEP_EXPORT_EACH=true

# Fixní rozměry flíčku během sweepování jiných cílů (např. zanoření, transformátoru či fázování) v mm:
SWEEP_PATCH_L=28.8
SWEEP_PATCH_W=28.8
