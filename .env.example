# ==============================================================================
# CONFIGURATION FILE FOR MICROSTRIP ANTENNA SIMULATIONS & SWEEPS (SDARS 2.332 GHz)
# ==============================================================================
# This example file serves as a template for the '.env' file.
# Copy it: 'cp .env.example .env' (or 'copy .env.example .env' on Windows) and adjust as needed.

# ==============================================================================
# 1. COMMON PARAMETERS (FOR BOTH MAIN AND SWEEP)
# ==============================================================================
# These parameters define system paths, hardware resources, model selection,
# and baseline material properties shared across single runs and parametric sweeps.

# --- 1.1 System Paths and Compute Resources ---
# When running the entire pipeline inside a container (`docker compose run --rm pipeline`,
# Docker-out-of-Docker via `/var/run/docker.sock`), `CONF_DIR` and `DATA_DIR` must
# contain absolute host paths so the `palace` container mounts the correct host
# directories. When running Python locally (`python src/main.py` or `python src/sweep.py`)
# with the `palace` solver in Docker, relative paths `.` and `./data` work directly.
CONF_DIR=.
DATA_DIR=./data
EXPORT_DIR=./export
# Number of CPU cores allocated to the Palace solver in Docker (MPI parallelism)
PALACE_CORES=1
# RAM limit for the Palace Docker container
PALACE_MEM_LIMIT=11g
# Total RAM + swap limit for the Palace Docker container (RAM + swap).
# For 11 GB RAM + 20 GB swap, set 31g (or -1 for unlimited access to system swap)
PALACE_MEMSWAP_LIMIT=31g
# Optional board manufacturing variant profile (e.g., different manufacturer / substrate parameters).
# Loads results/<variant>/<variant>.env (overrides values from root .env)
# and saves KiCad/Gerber outputs to results/<variant>/kicad/.
# ANTENNA_PROFILE=

# --- 1.2 Antenna Model Selection ---
# ANTENNA_MODEL selects the antenna topology and geometry generator:
#   1 = Model 1 (geometry_v1.py): Original model with a single 50 Ohm port and integrated
#       T-junction power divider and phasing line on one board.
#   2 = Model 2 (geometry_v2.py): Dual-port model with two 100 Ohm feeds, direct
#       inset into the patch, and an integrated Delta L phase-delay section on Port 1.
#   3 = Model 3 (geometry_v3.py): Hybrid two-stage matching (Path B) -
#       shallow notch y0 (~2.5 mm) + quarter-wave transformer w_T (~0.42 mm)
#       matching the patch to 100 Ohm + matched 100 Ohm line with Delta L phase shifter.
#   4 = Model 4 (geometry_v4.py): Final model completing Model 3 - combines both
#       100 Ohm feed branches via smooth curved arcs into a T-junction on a single 50 Ohm port (LHCP).
#   7 = Model 7 (geometry_v7.py): Model 4 mirrored across the Y-axis for opposite polarization (RHCP).
#       Preserves all tuning and matching of Model 4; excitation is at the right substrate edge.
ANTENNA_MODEL=4

# --- 1.3 Dielectric Substrate Parameters ---
# Dielectric thickness in mm (default: 1.52 mm for standard RF laminate / FR-4)
SUB_H=1.52
# Substrate relative permittivity epsilon_r (default: 4.3 for FR-4)
EPS_R=4.3
# Dielectric loss tangent tan(delta) (default: 0.02 for FR-4)
TAN_DELTA=0.02
# Design center frequency for lambda_g/4 section synthesis in GHz (default: 2.3325)
DESIGN_FREQ_GHZ=2.3325

# --- 1.4 Baseline Radiating Patch Geometry ---
# Square resonator dimensions in mm (for SDARS 2.3325 GHz):
#   - For Model 1: default 30.30 mm
#   - For Models 2, 3, 4, and 7: default 28.80 mm (tuned value in Model 3 e.g. 29.81 mm)
PATCH_L=28.8
PATCH_W=28.8


# ==============================================================================
# 2. SINGLE SIMULATION PARAMETERS (MAIN - python src/main.py)
# ==============================================================================
# These parameters control direct solver runs via 'main.py' (or 'docker compose run').

# --- 2.1 Simulation Frequency Range ---
# Frequencies in GHz per SDARS specification (operating band 2.320 to 2.345 GHz):
FREQ_MIN=2.320
FREQ_MAX=2.345
# Frequency step in GHz (e.g., 0.001 = 1 MHz step for fine curve, 0.005 = 5 MHz for quick test)
FREQ_STEP=0.001

# --- 2.2 Computational Mesh (Gmsh) and Adaptive Mesh Refinement (AMR) ---
# Maximum mesh element size in air volume in mm
MESH_SIZE_MAX=8.0
# Minimum element size on conductor edges and slots in mm
MESH_SIZE_MIN=0.5
# Distance from conductors with finest mesh in mm
MESH_DIST_MIN=0.5
# Distance at which mesh transitions to maximum size MESH_SIZE_MAX in mm
MESH_DIST_MAX=6.0
# Number of Palace adaptive mesh refinement (AMR) iterations:
#   0 = disabled (fast computation on initial mesh)
#   1 to 3 = number of adaptive refinement steps based on field error
AMR_MAX_ITS=2
# Relative field error tolerance for stopping AMR refinement (default: 0.2 = 20%)
AMR_THRESHOLD=0.2

# --- 2.3 Numerical Linear Solver (Palace - FGMRES / SuperLU) ---
# Relative convergence tolerance for the FGMRES linear solver
LINEAR_TOL=1e-6
# Maximum number of linear solver iterations
LINEAR_MAX_ITS=200
# Maximum Krylov subspace size for FGMRES restart (disabled / empty = full GMRES without restart)
# LINEAR_MAX_SIZE=
# Palace FEM basis function order (default: 2)
# SOLVER_ORDER=2

# --- 2.4 Far-Field Sampling and 3D Field Export ---
# Number of sampling points on the far-field sphere (e.g., 16200 = 2 deg step in theta/phi, 4050 = 4 deg step)
FARFIELD_NSAMPLE=16200
# 3D field save step to postpro directory for ParaView:
#   1 = save fields at every frequency step (enables phase animations and 3D visualization)
#   0 = do not save 3D fields, compute S-parameters and far-field only (fast, saves disk space)
SAVE_STEP=1

# --- 2.5 Port Impedance and Excitation Mode ---
# Nominal lumped port impedance in Ohms: when commented out, `main.py`
# automatically selects 50.0 for ANTENNA_MODEL=1/4/7 and 100.0 for ANTENNA_MODEL=2/3,
# unless explicitly overridden in `.env` or via the `--port-impedance` flag.
# PORT_IMPEDANCE=50.0
# Port excitation mode for 2-port models (Model 2 and Model 3):
#   'all' (or 'matrix', 'both') = Two-step solve for the full 2-port matrix S11, S21, S12, S22
#                                 and LHCP/RHCP radiation including Axial Ratio (AR).
#   '1'   (or 'bottom', 'ey')   = Drive bottom Port 1 (Ey) only, Port 2 terminated in 100 Ohm load.
#   '2'   (or 'left', 'ex')     = Drive left Port 2 (Ex) only, Port 1 terminated in 100 Ohm load.
#   'simultaneous'              = Drive both ports simultaneously in a single simulation step.
DRIVEN_PORT=all

# --- 2.6 Geometry Parameters Specific to MODEL 1 ---
# Feed inset into the patch in mm (0.0 = edge-fed directly at outer patch edge)
FEED_INSET=0.0
# Inset notch gap width in mm
FEED_INSET_GAP=0.5

# --- 2.7 Geometry Parameters Specific to MODEL 2 ---
# Bottom (Ey) and left (Ex) feed insets in mm (typically 4.8 to 5.4 mm for deep notches;
# template for ANTENNA_MODEL=2 - uncomment when using Model 2, defaults below apply to Model 3)
# FEED_INSET_B=5.2
# FEED_INSET_L=5.2
# FEED_INSET_GAP_B=0.5
# FEED_INSET_GAP_L=0.5
# Explicit feed line lengths for Model 2 in mm (optional; default: auto via lambda_g/4)
# FEED_LEN_B=43.51
# FEED_LEN_L=24.85
# FEED_DELTA_L=18.66

# --- 2.8 Geometry Parameters Specific to MODEL 3 and MODEL 4 (Hybrid Matching) ---
# Shallow notch depth on bottom and left arms in mm (default: 2.50 mm to lower edge impedance to ~140 Ohm)
FEED_INSET_B=2.5
FEED_INSET_L=2.5
FEED_INSET_GAP_B=0.5
FEED_INSET_GAP_L=0.5
# Width of internal quarter-wave transformer w_T in mm (default: 0.42 mm -> impedance Z_T ~ 118.7 Ohm)
TRANS_W=0.42
# Physical transformer length l_T in mm (optional; default: auto lambda_g/4 ~ 18.88 mm)
# TRANS_L=18.88
# Phasing delay section Delta L in matched 100 Ohm line in mm (default: auto lambda_g/4 ~ 18.66 mm)
# FEED_DELTA_L=18.66

# --- 2.9 Geometry Parameters Specific to MODEL 4 (Final model: rotated left 50 Ohm T-junction without meander) ---
# Centerline radius of circular arcs for all 90 deg bends in mm (default: 3.0 mm >= 3*w_100)
FEED_BEND_RADIUS=3.0
# Inner corner fillet radius at the T-junction in mm (0.0 = sharp T-junction, default: 0.8 mm)
FEED_T_FILLET_R=0.8
# Length of main 50 Ohm feed from left substrate edge to left edge of vertical T-junction stem in mm (default: 9.0 mm)
FEED_50_LEN=9.0
# Optional trace width overrides in mm (default: auto synthesis from PORT_IMPEDANCE and 2*PORT_IMPEDANCE)
# FEED_50_W=2.98
# FEED_100_W=0.694
# Straight 100 Ohm line section between 90 deg arc and quarter-wave transformer input
# to let higher-order modes decay before width step (recommended: >= 3 * SUB_H, default: 4.6 mm)
FEED_END_STRAIGHT=4.6
# Lateral offset of vertical 100 Ohm axis from left transformer input x_junc_l in mm (default: auto = FEED_END_STRAIGHT + FEED_BEND_RADIUS = 7.6 mm)
# FEED_ARM_OFFSET=7.6
# Minimum dielectric substrate margin outside conductors in mm (default: 8.0 mm >= 5*h)
SUB_MARGIN=8.0
# Optional explicit pinning of T-junction coordinates and minimum substrate dimensions in mm:
# FEED_T_X=-38.88
# FEED_T_Y=-28.91
# SUB_W=96.46
# SUB_L=94.46


# ==============================================================================
# 3. PARAMETRIC SWEEP PARAMETERS (SWEEP - python src/sweep.py)
# ==============================================================================
# Select one of the two sweep profiles via SWEEP_PROFILE:
#   SWEEP_PROFILE=precise  -> 3.1 PRECISE CONVERGED SWEEP (guaranteed accuracy, no frequency jumps)
#   SWEEP_PROFILE=fast     -> 3.2 FAST EXPLORATORY SWEEP (rapid rough scan)
SWEEP_PROFILE=precise

# --- Common Sweep Settings (apply to both profiles) ---
# SWEEP_TARGET specifies which physical parameter is varied across the sweep:
#   'patch_l'     = Sweep resonant patch length L to center frequency (M1..M4)
#   'trans_w'     = Sweep quarter-wave transformer width w_T (M3, M4)
#   'trans_l'     = Sweep transformer length l_T (M3, M4)
#   'delta_l'     = Sweep phasing section Delta L in 100 Ohm line for circular polarization / AR (M2..M4)
#   'inset'       = Sweep feed inset depth (M1..M4)
#   'bend_radius' = Sweep bend arc radius (Model 4 only)
#   'feed_50_len' = Sweep 50 Ohm feed length to T-junction (Model 4 only)
#   'feed_lens'   = Sweep microstrip feed line lengths (Model 2)
SWEEP_TARGET=patch_l

# Excitation during sweep:
#   '2'   = drive Port 2 only (fast tuning of left arm Ex without phase shifter)
#   '1'   = drive Port 1 only (fast tuning of bottom arm Ey)
#   'all' = full 2-step simulation of both ports (S-matrix, LHCP radiation, and AR)
SWEEP_DRIVEN_PORT=2

# List of swept patch dimensions L = W in mm:
SWEEP_PATCH_LENGTHS=29.6, 29.7, 29.8, 29.81, 29.9, 30.0

# Optional lists for other sweep targets:
# SWEEP_TRANS_W=0.35, 0.38, 0.40, 0.42, 0.45, 0.50
# SWEEP_TRANS_L=17.5, 18.0, 18.5, 18.88, 19.5, 20.0
# SWEEP_DELTA_L=17.0, 17.5, 18.0, 18.66, 19.0, 19.5
# SWEEP_INSETS=1.5, 2.0, 2.5, 3.0, 3.5
# SWEEP_BEND_RADII=2.0, 2.5, 3.0, 3.5, 4.0
# SWEEP_FEED_50_LEN=6.0, 8.0, 9.0, 10.0, 12.0

# Export archive packages after each sweep step (ZIP with data and plots):
SWEEP_EXPORT_EACH=true

# Fixed patch dimensions when sweeping other targets:
SWEEP_PATCH_L=29.81
SWEEP_PATCH_W=29.81


# ------------------------------------------------------------------------------
# 3.1 PRECISE SWEEP SECTION (SWEEP_PROFILE=precise)
#     Guaranteed high accuracy (AMR adaptive refinement to field error < 6%,
#     resonant frequency stability < 0.2 MHz without discretization jumps).
# ------------------------------------------------------------------------------
SWEEP_PRECISE_FREQ_MIN=2.320
SWEEP_PRECISE_FREQ_MAX=2.345
SWEEP_PRECISE_FREQ_STEP=0.001

# Deterministic initial Gmsh mesh (resolves 0.5 mm slot into 2-3 elements)
SWEEP_PRECISE_MESH_SIZE_MAX=6.0
SWEEP_PRECISE_MESH_SIZE_MIN=0.28
SWEEP_PRECISE_MESH_DIST_MIN=0.4
SWEEP_PRECISE_MESH_DIST_MAX=4.5

# Adaptive mesh refinement (AMR): up to 3 iterations to guarantee field error < 6%
SWEEP_PRECISE_AMR_MAX_ITS=3
SWEEP_PRECISE_AMR_THRESHOLD=0.06

# FGMRES linear solver for precise sweep
SWEEP_PRECISE_LINEAR_TOL=1e-6
SWEEP_PRECISE_LINEAR_MAX_ITS=200

# Far-field sampling (4050 points = 4 deg step for optimal speed)
SWEEP_PRECISE_FARFIELD_NSAMPLE=4050
# 3D field saving (0 = numerical results only, saves disk space)
SWEEP_PRECISE_SAVE_STEP=0


# ------------------------------------------------------------------------------
# 3.2 FAST SWEEP SECTION (SWEEP_PROFILE=fast)
#     Rapid exploratory sweep for coarse search and parameter mapping.
#     AMR disabled (0 iterations), coarser mesh, larger 2 MHz frequency step.
# ------------------------------------------------------------------------------
SWEEP_FAST_FREQ_MIN=2.320
SWEEP_FAST_FREQ_MAX=2.345
SWEEP_FAST_FREQ_STEP=0.002

# Coarser initial Gmsh mesh
SWEEP_FAST_MESH_SIZE_MAX=8.0
SWEEP_FAST_MESH_SIZE_MIN=0.35
SWEEP_FAST_MESH_DIST_MIN=0.5
SWEEP_FAST_MESH_DIST_MAX=5.0

# Adaptive mesh refinement (AMR) disabled for maximum speed
SWEEP_FAST_AMR_MAX_ITS=0
SWEEP_FAST_AMR_THRESHOLD=0.15

# Linear solver with relaxed tolerance
SWEEP_FAST_LINEAR_TOL=1e-5
SWEEP_FAST_LINEAR_MAX_ITS=100

# Reduced far-field sampling
SWEEP_FAST_FARFIELD_NSAMPLE=2025
SWEEP_FAST_SAVE_STEP=0
