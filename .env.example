CONF_DIR=.
DATA_DIR=./data
PALACE_CORES=5

# Frekvenční rozsah a krok sweepu (GHz)
FREQ_MIN=2.320
FREQ_MAX=2.345
FREQ_STEP=0.005

# Nastavení sítě (mm) a adaptivního zjemnění (AMR)
MESH_SIZE_MAX=5.0
MESH_SIZE_MIN=0.5
AMR_MAX_ITS=2

# Geometrie vyzařujícího flíčku (mm)
PATCH_L=30.3
PATCH_W=30.3

# Zanoření napaječe (inset feed) v mm (0.0 = napájení na hraně)
FEED_INSET=0.0

# Šířka mezery zářezu (gap po stranách napaječe w3) v mm (volitelné, výchozí: rovno šířce w3 cca 0.69 mm)
# FEED_INSET_GAP=0.69
# Alternativně celková šířka výřezu v mm:
# FEED_INSET_WIDTH=2.07

# Substrát a dielektrikum (volitelné)
# SUB_H=1.52
# EPS_R=4.3
# TAN_DELTA=0.02
