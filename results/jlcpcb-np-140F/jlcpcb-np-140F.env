# ==============================================================================
# VÝROBNÍ PROFIL VARIANTY DESKY: JLCPCB Nan Ya NP-140F (h = 1.60 mm, eps_r = 4.1)
# ==============================================================================
# Zdroj parametrů substrátu:
#   - Datasheet: NP-140F-Datasheets.pdf (Nan Ya Plastics Corp., Copper Clad
#     Laminate NP-140F, vzorek 0.062" 1/1 = 1.60 mm, IPC-TM-650 2.5.5.9, C-24/23/50)
#   - Typical values @ 1 GHz (nejbližší k pracovní frekvenci 2.3325 GHz):
#       Permittivity 1 GHz = 4.0–4.2   -> EPS_R=4.1
#       Loss Tangent 1 GHz = 0.012–0.014 -> TAN_DELTA=0.013
#   - Tloušťka substrátu JLCPCB: SUB_H=1.60 mm
#
# UPOZORNĚNÍ:
#   Rozměry flíčku (PATCH_L, PATCH_W) a délky napájecí sítě jsou počáteční
#   analytický odhad odvozený škálováním z odladěné varianty 'urel'.
#   Před výrobou DPS je nutné provést FEM doladění (sweep) v řešiči Palace!
# ==============================================================================

# --- 1. Identifikace profilu a potisk DPS (F.SilkS) ---
PROFILE_NAME=jlcpcb-np-140F
SILKSCREEN_SUBTITLE=JLCPCB NP-140F h=1.60mm er=4.1

# --- 2. Topologie antény ---
ANTENNA_MODEL=4

# --- 3. Parametry dielektrického substrátu (Nan Ya NP-140F, 1 GHz typical) ---
SUB_H=1.60
EPS_R=4.1
TAN_DELTA=0.013
DESIGN_FREQ_GHZ=2.3325

# --- 4. Geometrie vyzařujícího flíčku (POČÁTEČNÍ ANALYTICKÝ ODHAD) ---
# Škálováno z odladěného 'urel' (29.95 mm) poměrem Hammerstadova rezonančního
# modelu: L_ana(1.60, 4.1) / L_ana(1.52, 4.3) = 31.599 / 30.896 = 1.02276
# -> 29.95 * 1.02276 = 30.63 mm (před FEM přeladěním v Palace).
PATCH_L=30.63
PATCH_W=30.63

# --- 5. Mělký zářez a čtvrtvlnné transformátory ---
FEED_INSET_B=2.5
FEED_INSET_L=2.5
FEED_INSET_GAP_B=0.5
FEED_INSET_GAP_L=0.5
# Šířka transformátoru 0.34 mm odpovídá Z_T ≈ 131.2 Ohm (ekvivalent 0.30 mm / 131.4 Ohm na 'urel')
TRANS_W=0.34
# Zakomentováno = automatický analytický výpočet lambda_g/4 pro h=1.60 mm, eps_r=4.1:
# TRANS_L_B=
# TRANS_L_L=
# FEED_DELTA_L=

# --- 6. Napájecí síť Modelu 4 (oblouky, T-článek, 50 Ohm přívod, okraje) ---
FEED_BEND_RADIUS=3.0
FEED_T_FILLET_R=0.8
FEED_50_LEN=9.0
# Doporučení >= 3 * SUB_H (3 * 1.60 = 4.80 mm)
FEED_END_STRAIGHT=4.8
SUB_MARGIN=8.0

# --- 7. SMA konektor (Cinch Johnson 142-0701-801, G-S-G rozhraní) ---
SMA_GAP=0.70
SMA_PAD_LEN=3.50
SMA_PAD_W=1.50
