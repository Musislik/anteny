# ==============================================================================
# BOARD VARIANT MANUFACTURING PROFILE: JLCPCB Nan Ya NP-140F (h = 1.60 mm, eps_r = 4.1)
# ==============================================================================
# Substrate parameter source:
#   - Datasheet: NP-140F-Datasheets.pdf (Nan Ya Plastics Corp., Copper Clad
#     Laminate NP-140F, sample 0.062" 1/1 = 1.60 mm, IPC-TM-650 2.5.5.9, C-24/23/50)
#   - Typical values @ 1 GHz (closest to operating frequency 2.3325 GHz):
#       Permittivity 1 GHz = 4.0-4.2   -> EPS_R=4.1
#       Loss Tangent 1 GHz = 0.012-0.014 -> TAN_DELTA=0.013
#   - JLCPCB substrate thickness: SUB_H=1.60 mm
#
# NOTICE:
#   Patch dimensions (PATCH_L, PATCH_W) and feed network lengths are an initial
#   analytical estimate derived by scaling from the tuned 'urel' variant.
#   Before PCB fabrication, perform FEM tuning (sweep) in the Palace solver!
# ==============================================================================

# --- 1. Profile Identification and PCB Silkscreen (F.SilkS) ---
PROFILE_NAME=jlcpcb-np-140F
SILKSCREEN_SUBTITLE=JLCPCB NP-140F h=1.60mm er=4.1

# --- 2. Antenna Topology ---
ANTENNA_MODEL=4

# --- 3. Dielectric Substrate Parameters (Nan Ya NP-140F, 1 GHz typical) ---
SUB_H=1.60
EPS_R=4.1
TAN_DELTA=0.013
DESIGN_FREQ_GHZ=2.3325

# --- 4. Radiating Patch Geometry (INITIAL ANALYTICAL ESTIMATE) ---
# Calibrated against FEM-tuned 'urel' (h=1.52 mm, er=4.3, y0=2.5 mm -> 29.95 mm,
# f0=2.3325 GHz, sensitivity df0/dL ~= -75.2 MHz/mm) by comparing three model families:
#   1) Hammerstad quasi-static (rf_calc.py):           ratio 1.02276 -> 30.63 mm
#   2) Dispersive KJ-1982 / Kobayashi-1988 + KJK-1981: ratio 1.02202 -> 30.61 mm (addit. 30.62 mm)
#   3) Cavity/fringing (h/L, tan d) + notch y0=2.5 mm correction:    -> 30.62 mm
# Selected 30.62 mm (midpoint of 30.61-30.63 mm, model spread +/-0.75 MHz).
PATCH_L=30.62
PATCH_W=30.62

# --- 5. Shallow Inset Notch and Quarter-Wave Transformers ---
FEED_INSET_B=2.5
FEED_INSET_L=2.5
FEED_INSET_GAP_B=0.5
FEED_INSET_GAP_L=0.5
# Transformer width 0.34 mm corresponds to Z_T ~= 131.2 Ohm (equivalent to 0.30 mm / 131.4 Ohm on 'urel')
TRANS_W=0.34
# Commented out = automatic analytical lambda_g/4 calculation for h=1.60 mm, eps_r=4.1:
# TRANS_L_B=
# TRANS_L_L=
# FEED_DELTA_L=

# --- 6. Model 4 Feed Network (arcs, T-junction, 50 Ohm feed, margins) ---
FEED_BEND_RADIUS=3.0
FEED_T_FILLET_R=0.8
FEED_50_LEN=9.0
# Recommended >= 3 * SUB_H (3 * 1.60 = 4.80 mm)
FEED_END_STRAIGHT=4.8
SUB_MARGIN=8.0

# --- 7. SMA Connector (Cinch Johnson 142-0701-801, G-S-G interface) ---
SMA_GAP=0.70
SMA_PAD_LEN=3.50
SMA_PAD_W=1.50
