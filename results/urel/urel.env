# ==============================================================================
# VÝROBNÍ PROFIL VARIANTY DESKY: UREL FR-4 (h = 1.52 mm, eps_r = 4.3)
# ==============================================================================
# Odladěná referenční varianta Modelu 4 (LHCP SDARS 2.3325 GHz) pro výrobu na
# ÚREL (VUT FEKT) ze substrátu FR-4 o tloušťce 1.52 mm.
# Všechny geometrické rozměry jsou finálně doladěny FEM simulacemi v Palace.
# ==============================================================================

# --- 1. Identifikace profilu a potisk DPS (F.SilkS) ---
PROFILE_NAME=urel
SILKSCREEN_SUBTITLE=UREL FR4 h=1.52mm er=4.3

# --- 2. Topologie antény ---
ANTENNA_MODEL=4

# --- 3. Parametry dielektrického substrátu ---
SUB_H=1.52
EPS_R=4.3
TAN_DELTA=0.02
DESIGN_FREQ_GHZ=2.3325

# --- 4. Geometrie vyzařujícího flíčku (odladěno pro SDARS 2.3325 GHz) ---
PATCH_L=29.95
PATCH_W=29.95

# --- 5. Mělký zářez a čtvrtvlnné transformátory (Hybridní přizpůsobení) ---
FEED_INSET_B=2.5
FEED_INSET_L=2.5
FEED_INSET_GAP_B=0.5
FEED_INSET_GAP_L=0.5
TRANS_W=0.3
TRANS_L_B=19.50
TRANS_L_L=18.70
FEED_DELTA_L=18.84

# --- 6. Napájecí síť Modelu 4 (oblouky, T-článek, 50 Ohm přívod, okraje) ---
FEED_BEND_RADIUS=3.0
FEED_T_FILLET_R=0.8
FEED_50_LEN=9.0
FEED_END_STRAIGHT=4.6
SUB_MARGIN=8.0

# --- 7. SMA konektor (Cinch Johnson 142-0701-801, G-S-G rozhraní) ---
SMA_GAP=0.70
SMA_PAD_LEN=3.50
SMA_PAD_W=1.50
