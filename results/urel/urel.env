# ==============================================================================
# BOARD VARIANT MANUFACTURING PROFILE: UREL FR-4 (h = 1.52 mm, eps_r = 4.3)
# ==============================================================================
# Tuned reference variant of Model 4 (LHCP SDARS 2.3325 GHz) for fabrication at
# UREL (BUT FEEC) on FR-4 substrate of thickness 1.52 mm.
# All geometric dimensions are finely tuned using FEM simulations in Palace.
# ==============================================================================

# --- 1. Profile Identification and PCB Silkscreen (F.SilkS) ---
PROFILE_NAME=urel
SILKSCREEN_SUBTITLE=UREL FR4 h=1.52mm er=4.3

# --- 2. Antenna Topology ---
ANTENNA_MODEL=4

# --- 3. Dielectric Substrate Parameters ---
SUB_H=1.52
EPS_R=4.3
TAN_DELTA=0.02
DESIGN_FREQ_GHZ=2.3325

# --- 4. Radiating Patch Geometry (tuned for SDARS 2.3325 GHz) ---
PATCH_L=29.95
PATCH_W=29.95

# --- 5. Shallow Inset Notch and Quarter-Wave Transformers (Hybrid Matching) ---
FEED_INSET_B=2.5
FEED_INSET_L=2.5
FEED_INSET_GAP_B=0.5
FEED_INSET_GAP_L=0.5
TRANS_W=0.3
TRANS_L_B=19.50
TRANS_L_L=18.70
FEED_DELTA_L=18.84

# --- 6. Model 4 Feed Network (arcs, T-junction, 50 Ohm feed, margins) ---
FEED_BEND_RADIUS=3.0
FEED_T_FILLET_R=0.8
FEED_50_LEN=9.0
FEED_END_STRAIGHT=4.6
SUB_MARGIN=8.0

# --- 7. SMA Connector (Cinch Johnson 142-0701-801, G-S-G interface) ---
SMA_GAP=0.70
SMA_PAD_LEN=3.50
SMA_PAD_W=1.50
