# Multi-stage sestavení reálného FEM řešiče Palace ze zdrojových kódů (AWS Labs)
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    gfortran \
    libopenmpi-dev \
    openmpi-bin \
    libopenblas-dev \
    pkg-config \
    python3 \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone --depth 1 https://github.com/awslabs/palace.git

WORKDIR /opt/palace/build
RUN cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DPALACE_WITH_SUPERLU=ON \
    -DPALACE_BUILD_EXTERNAL_DEPS=ON

RUN cmake --build . -j$(nproc) && cmake --install . --prefix /opt/palace_install

# Nyní bezpečně posbíráme všechny postavené knihovny, ať už jsou kdekoliv v adresáři build
RUN mkdir -p /opt/palace_libs && find /opt/palace/build -name "*.so*" -exec cp {} /opt/palace_libs/ \;

# Minimální finální runtime obraz
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y \
    openmpi-bin \
    libgomp1 \
    libgfortran5 \
    libopenblas0-pthread \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Zkopírujeme přímo výslednou binárku a wrapper skripty
COPY --from=builder /opt/palace/build/bin/* /usr/local/bin/
# Zkopírujeme všechny posbírané sdílené knihovny
COPY --from=builder /opt/palace_libs/ /usr/local/lib/
RUN ldconfig

WORKDIR /workspace
ENTRYPOINT ["palace"]
CMD ["-np", "4", "/workspace/data/config.json"]
