# Multi-stage build of the AWS Labs Palace FEM solver from source
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    gfortran \
    libopenmpi-dev \
    openmpi-bin \
    libopenblas-dev \
    pkg-config \
    python3 \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
ARG PALACE_VERSION=v0.19.0
RUN git clone --depth 1 --branch ${PALACE_VERSION} https://github.com/awslabs/palace.git

WORKDIR /opt/palace/build
RUN cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DPALACE_WITH_SUPERLU=ON \
    -DPALACE_BUILD_EXTERNAL_DEPS=ON

ARG PALACE_BUILD_JOBS
RUN cmake --build . -j"${PALACE_BUILD_JOBS:-$(nproc)}"

# Collect all built shared libraries wherever they are located in the build directory
RUN mkdir -p /opt/palace_libs && find /opt/palace/build -name "*.so*" -exec cp {} /opt/palace_libs/ \;

# Minimal final runtime image
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y \
    openmpi-bin \
    libgomp1 \
    libgfortran5 \
    libopenblas0-pthread \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Copy the compiled binary and wrapper scripts directly
COPY --from=builder /opt/palace/build/bin/* /usr/local/bin/
# Copy all collected shared libraries
COPY --from=builder /opt/palace_libs/ /usr/local/lib/
RUN ldconfig

WORKDIR /workspace
ENTRYPOINT ["palace"]
CMD ["-np", "4", "/workspace/data/config.json"]
