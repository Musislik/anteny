FROM python:3.11-slim

ARG TARGETARCH

# Instalace Docker CLI (aby python skript mohl z kontejneru spustit palace kontejner) a závislostí pro Gmsh/PyVista
RUN apt-get update && apt-get install -y \
    curl \
    docker.io \
    libgl1 \
    libglu1-mesa \
    libgomp1 \
    libglib2.0-0 \
    libxrender1 \
    libxcursor1 \
    libxft2 \
    libxinerama1 \
    xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" \
    && case "${ARCH}" in \
        amd64) COMPOSE_ARCH="x86_64" ;; \
        arm64) COMPOSE_ARCH="aarch64" ;; \
        *) echo "Unsupported TARGETARCH: ${ARCH}" >&2; exit 1 ;; \
    esac \
    && curl -SL "https://github.com/docker/compose/releases/download/v2.24.0/docker-compose-linux-${COMPOSE_ARCH}" -o /usr/local/bin/docker-compose \
    && chmod +x /usr/local/bin/docker-compose

WORKDIR /workspace

# Instalace Python balíčků
COPY requirements.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements.txt
